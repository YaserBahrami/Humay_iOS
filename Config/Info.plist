<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Humay</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Cormorant Garamond, SIL Open Font License 1.1. Weights 300 and 400 only:
	     the brand lock allows no heavier weight. See Humay/Resources/Fonts/OFL.txt.
	     Values here are filenames; Font.custom takes the PostScript name instead. -->
	<key>UIAppFonts</key>
	<array>
		<string>CormorantGaramond-Light.otf</string>
		<string>CormorantGaramond-LightItalic.otf</string>
		<string>CormorantGaramond-Regular.otf</string>
		<string>CormorantGaramond-Italic.otf</string>
	</array>

	<!-- Opt out of the iOS 26 system appearance.

	     The floating translucent tab bar lets content show through itself and sits on a
	     rounded capsule, which is the opposite of a design built on a flat ground,
	     square edges and hairline rules — a reading would be visible through the chrome
	     while being read. The alternative is a hand-built tab bar, which would cost the
	     free accessibility, keyboard and state behaviour of the real one.

	     This key is a transitional affordance and will not last forever. Revisit when
	     the design has an explicit position on the newer appearance. -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
