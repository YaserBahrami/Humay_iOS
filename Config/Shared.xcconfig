// Humay — settings shared by every target and configuration.
//
// Target-specific settings (bundle identifiers, TEST_HOST, INFOPLIST_FILE) live in
// the project file because they cannot be shared. Everything else belongs here.

IPHONEOS_DEPLOYMENT_TARGET = 18.0
SDKROOT = iphoneos

// V1 is iPhone, portrait. iPad is a planned dedicated design and implementation
// phase — see docs/design/DESIGN_AUTHORITY.md section 03A.
TARGETED_DEVICE_FAMILY = 1

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = YES

// Isolation is opt-in rather than defaulted to MainActor.
//
// The Domain layer is pure value types with synthesized Hashable and Equatable
// conformances. Under MainActor-by-default those conformances become isolated, which
// then cannot satisfy the Sendable requirement on a generic like FactValue<Bhava> —
// the layer that should be the most concurrency-neutral becomes the most constrained.
//
// SwiftUI views still get MainActor from the View protocol, and repositories, view
// models and the composition root declare @MainActor explicitly, which is worth
// writing down anyway.
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_C_LANGUAGE_STANDARD = gnu17
GCC_NO_COMMON_BLOCKS = YES

CLANG_WARN_BOOL_CONVERSION = YES
CLANG_WARN_CONSTANT_CONVERSION = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_ENUM_CONVERSION = YES
CLANG_WARN_INFINITE_RECURSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_RANGE_LOOP_ANALYSIS = YES
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
CLANG_WARN_UNREACHABLE_CODE = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES

ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ENABLE_PREVIEWS = YES

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Kept ready for development-device signing and archives. Simulator verification
// may pass CODE_SIGNING_ALLOWED=NO on the xcodebuild command line; it is never
// committed here.
CODE_SIGN_STYLE = Automatic

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
